name: 'تقسیم و ارسال با split (نام قطعات = اسم اصلی.partXXX) - چند لینکی'

on:
  workflow_dispatch:
    inputs:
      links:
        description: 'لینک‌های مستقیم فایل‌ها (هر لینک در یک خط)'
        required: true
        type: string

jobs:
  send:
    runs-on: ubuntu-latest
    steps:
      - name: پردازش ترتیبی همه لینک‌ها
        env:
          TOKEN: ${{ secrets.BALE_BOT_TOKEN }}
          CHAT_ID: ${{ secrets.BALE_CHAT_ID }}
        run: |
          # تابع ارسال پیام به بله
          send_msg() {
            curl -s -X POST -F chat_id=${CHAT_ID} -F text="$1" https://tapi.bale.ai/bot${TOKEN}/sendMessage
          }
          
          # تابع ارسال قطعه با تلاش مجدد
          send_with_retry() {
            local file=$1
            local max_attempts=5
            local attempt=1
            local delay=10
            while [ $attempt -le $max_attempts ]; do
              echo "تلاش $attempt از $max_attempts برای ارسال $file ..."
              response=$(curl -s -w "\n%{http_code}" -F chat_id=${CHAT_ID} -F document=@"${file}" https://tapi.bale.ai/bot${TOKEN}/sendDocument)
              http_code=$(echo "$response" | tail -n1)
              if [ "$http_code" -eq 200 ]; then
                echo "✅ $file با موفقیت ارسال شد."
                return 0
              fi
              if [ "$http_code" -eq 429 ]; then
                echo "⚠️ ازدحام سرور، صبر ${delay} ثانیه..."
                sleep $delay
                delay=$((delay * 2))
                attempt=$((attempt + 1))
              else
                echo "❌ خطا با کد $http_code برای $file"
                return 1
              fi
            done
            echo "❌ شکست بعد از $max_attempts تلاش"
            return 1
          }
          
          # خواندن لینک‌ها (هر خط یک لینک)
          mapfile -t links <<< "${{ github.event.inputs.links }}"
          total=${#links[@]}
          counter=1
          
          send_msg "📋 شروع پردازش $total فایل به ترتیب"
          
          for URL in "${links[@]}"; do
            # حذف whitespace
            URL=$(echo "$URL" | xargs)
            [ -z "$URL" ] && continue
            
            send_msg "📁 ($counter/$total) شروع پردازش فایل"
            
            # استخراج نام فایل
            RAW_FILENAME=$(basename "$URL" | cut -d '?' -f1)
            [ -z "$RAW_FILENAME" ] && RAW_FILENAME="file_$counter"
            
            # اطلاع از تعداد قطعات (بدون دانلود کامل)
            SIZE=$(curl -sI -L "$URL" | grep -i content-length | tail -1 | awk '{print $2}' | tr -d '\r')
            if [ -n "$SIZE" ] && [ "$SIZE" -gt 0 ]; then
              NUM_PARTS=$(( (SIZE + 18*1024*1024 - 1) / (18*1024*1024) ))
            else
              NUM_PARTS="نامشخص"
            fi
            send_msg "📦 فایل: $RAW_FILENAME\n🔢 تعداد قطعات ۱۸ مگابایتی: $NUM_PARTS\n⏳ در حال دانلود..."
            
            # دانلود فایل
            curl -L -o original_file.dat "$URL"
            if [ $? -ne 0 ]; then
              send_msg "❌ خطا در دانلود $RAW_FILENAME. رد شدن از این فایل."
              counter=$((counter + 1))
              continue
            fi
            
            # تقسیم با split
            split -b 18M -d -a 3 original_file.dat part_
            
            # تغییر نام قطعات به اسم اصلی.partXXX
            for file in part_*; do
              NUMBER=$(echo "$file" | sed 's/part_//')
              mv "$file" "${RAW_FILENAME}.part${NUMBER}"
            done
            
            # ارسال همه قطعات
            for piece in ${RAW_FILENAME}.part*; do
              if [ -f "$piece" ]; then
                send_with_retry "$piece"
                sleep 2
              fi
            done
            
            # پاکسازی فایل‌های موقت
            rm -f original_file.dat ${RAW_FILENAME}.part*
            
            send_msg "✅ ارسال $RAW_FILENAME با موفقیت کامل شد."
            counter=$((counter + 1))
            sleep 3
          done
          
          send_msg "🎉 پردازش همه $total فایل به پایان رسید."
