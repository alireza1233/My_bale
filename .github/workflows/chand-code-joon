name: '(چند لینکی ترتیبی)'

on:
  workflow_dispatch:
    inputs:
      links:
        description: 'لینک‌های مستقیم (هر لینک در یک خط)'
        required: true

jobs:
  send:
    runs-on: ubuntu-latest
    steps:
      - name: پردازش ترتیبی لینک‌ها
        env:
          TOKEN: ${{ secrets.BALE_BOT_TOKEN }}
          CHAT_ID: ${{ secrets.BALE_CHAT_ID }}
        run: |
          # تابع ارسال پیام
          send_msg() {
            curl -s -X POST -F chat_id=${CHAT_ID} -F text="$1" https://tapi.bale.ai/bot${TOKEN}/sendMessage
          }
          
          # تابع ارسال فایل با تلاش مجدد
          send_with_retry() {
            local file=$1
            local max_attempts=5
            local attempt=1
            local delay=10
            while [ $attempt -le $max_attempts ]; do
              echo "تلاش $attempt برای ارسال $file"
              response=$(curl -s -w "\n%{http_code}" -F chat_id=${CHAT_ID} -F document=@"${file}" https://tapi.bale.ai/bot${TOKEN}/sendDocument)
              http_code=$(echo "$response" | tail -n1)
              if [ "$http_code" -eq 200 ]; then
                echo "✅ $file ارسال شد"
                return 0
              fi
              if [ "$http_code" -eq 429 ]; then
                echo "⚠️ ازدحام، صبر $delay ثانیه"
                sleep $delay
                delay=$((delay * 2))
                attempt=$((attempt + 1))
              else
                echo "❌ خطا $http_code برای $file"
                return 1
              fi
            done
            echo "❌ شکست بعد از $max_attempts تلاش"
            return 1
          }
          
          # ذخیره لینک‌ها در یک فایل موقت
          echo "${{ github.event.inputs.links }}" > links.txt
          
          total=$(grep -c '[^[:space:]]' links.txt)
          counter=1
          
          send_msg "📋 شروع پردازش $total فایل"
          
          while IFS= read -r URL || [ -n "$URL" ]; do
            # حذف فاصله ابتدا و انتها
            URL=$(echo "$URL" | xargs)
            [ -z "$URL" ] && continue
            
            send_msg "📁 ($counter/$total) در حال پردازش..."
            
            # نام فایل از لینک
            RAW_FILENAME=$(basename "$URL" | cut -d '?' -f1)
            [ -z "$RAW_FILENAME" ] && RAW_FILENAME="file_$counter"
            
            # محاسبه تعداد قطعات
            SIZE=$(curl -sI -L "$URL" | grep -i content-length | tail -1 | awk '{print $2}' | tr -d '\r')
            if [ -n "$SIZE" ] && [ "$SIZE" -gt 0 ]; then
              NUM_PARTS=$(( (SIZE + 18*1024*1024 - 1) / (18*1024*1024) ))
            else
              NUM_PARTS="نامشخص"
            fi
            send_msg "📦 $RAW_FILENAME\n🔢 قطعات: $NUM_PARTS\n⏳ دانلود..."
            
            # دانلود
            curl -L -o original_file.dat "$URL" || {
              send_msg "❌ خطا در دانلود $RAW_FILENAME، رد شدن"
              counter=$((counter+1))
              continue
            }
            
            # تقسیم
            split -b 18M -d -a 3 original_file.dat part_
            
            # تغییر نام
            for file in part_*; do
              NUMBER=$(echo "$file" | sed 's/part_//')
              mv "$file" "${RAW_FILENAME}.part${NUMBER}"
            done
            
            # ارسال قطعات
            for piece in ${RAW_FILENAME}.part*; do
              [ -f "$piece" ] && send_with_retry "$piece" && sleep 2
            done
            
            # پاکسازی
            rm -f original_file.dat ${RAW_FILENAME}.part*
            
            send_msg "✅ $RAW_FILENAME تکمیل شد"
            counter=$((counter+1))
            sleep 3
          done < links.txt
          
          send_msg "🎉 همه $total فایل پردازش شدند"
